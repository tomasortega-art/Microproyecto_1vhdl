architecture Dataflow of logic_display_control is
begin

    -- Selección concurrentemente del tiempo a visualizar en los displays
    tiempo_a_mostrar <= ("00" & tiempo_35s) when modo_exceso = '0' else
                        tiempo_extra;

    -- Lógica concurrente para el indicador de felicitación
    led_felicitacion <= salio_a_tiempo;

end Dataflow;
