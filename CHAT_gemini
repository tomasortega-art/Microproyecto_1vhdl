VHDLlibrary IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity fsm_control is
    Port (
        clk      : in  STD_LOGIC;
        reset    : in  STD_LOGIC;
        start    : in  STD_LOGIC;
        stop     : in  STD_LOGIC;
        enable   : out STD_LOGIC;
        rst_out  : out STD_LOGIC
    );
end fsm_control;

architecture Behavioral of fsm_control is
    type estado_type is (IDLE, RUNNING, PAUSED);
    signal estado : estado_type := IDLE;
begin

    process(clk, reset)
    begin
        if reset = '1' then
            estado <= IDLE;
            enable <= '0';
            rst_out <= '1';
        elsif rising_edge(clk) then
            rst_out <= '0';
            case estado is
                when IDLE =>
                    enable <= '0';
                    if start = '1' then
                        estado <= RUNNING;
                    end if;

                when RUNNING =>
                    enable <= '1';
                    if stop = '1' then
                        estado <= PAUSED;
                    end if;

                when PAUSED =>
                    enable <= '0';
                    if start = '1' then
                        estado <= RUNNING;
                    end if;
            end case;
        end if;
    end process;

end Behavioral;
