use IEEE.NUMERIC_STD.ALL;

entity contador_exceso is
    Port (
        clk_1hz         : in  STD_LOGIC;
        reset           : in  STD_LOGIC;
        presencia       : in  STD_LOGIC;
        activar_exceso  : in  STD_LOGIC;
        tiempo_extra    : out STD_LOGIC_VECTOR(7 downto 0);
        alarma_led      : out STD_LOGIC
    );
end contador_exceso;

architecture Behavioral of contador_exceso is
    signal seg_extra : integer range 0 to 255 := 0;
begin

    process(clk_1hz, reset)
    begin
        if reset = '1' then
            seg_extra <= 0;
            alarma_led <= '0';
        elsif rising_edge(clk_1hz) then
            if presencia = '1' and activar_exceso = '1' then
                alarma_led <= '1';
                if seg_extra < 255 then
                    seg_extra <= seg_extra + 1;
                end if;
            else
                if presencia = '0' then
                    seg_extra <= 0;
                    alarma_led <= '0';
                end if;
            end if;
        end if;
    end process;

    tiempo_extra <= std_logic_vector(to_unsigned(seg_extra, 8));

end Behavioral;
