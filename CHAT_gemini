library IEEE;
use IEEE.STD_LOGIC_1164.ALL;

entity logic_display_control is
    Port (
        tiempo_35s       : in  STD_LOGIC_VECTOR(5 downto 0);
        tiempo_extra     : in  STD_LOGIC_VECTOR(7 downto 0);
        modo_exceso      : in  STD_LOGIC;
        salio_a_tiempo   : in  STD_LOGIC;
