use IEEE.STD_LOGIC_1164.ALL;

entity btn_single_control is
    Port (
        clk       : in  STD_LOGIC; -- Reloj de 1 Hz
        btn       : in  STD_LOGIC; -- Botón único (start/stop/reset)
        enable    : out STD_LOGIC; -- Control de conteo
        reset_out : out STD_LOGIC  -- Señal de reinicio
    );
end btn_single_control;

architecture Behavioral of btn_single_control is
    type estado_type is (IDLE, PRESIONADO, ESPERA_SOLTAR, GENERAR_RESET);
    signal estado : estado_type := IDLE;
    
    signal tiempo_presionado : integer range 0 to 3 := 0;
    signal estado_run        : STD_LOGIC := '0';
begin

    process(clk)
    begin
        if rising_edge(clk) then
            reset_out <= '0'; -- Valor por defecto
            
            case estado is
                when IDLE =>
                    tiempo_presionado <= 0;
                    if btn = '1' then
                        tiempo_presionado <= 1;
                        estado <= PRESIONADO;
                    end if;

                when PRESIONADO =>
                    if btn = '1' then
                        if tiempo_presionado >= 2 then
                            -- Presionado por más de 2 segundos: Activar Reset
                            reset_out <= '1';
                            estado_run <= '0'; -- Detiene el conteo
                            estado <= GENERAR_RESET;
                        else
                            tiempo_presionado <= tiempo_presionado + 1;
                        end if;
                    else
                        -- Se soltó antes de 2 segundos: Alternar Start / Stop
                        estado_run <= not estado_run;
                        estado <= IDLE;
                    end if;

                when GENERAR_RESET =>
                    -- Mantiene el reset activo y espera a que liberen el botón
                    reset_out <= '1';
                    if btn = '0' then
                        estado <= IDLE;
                    end if;

                when ESPERA_SOLTAR =>
                    if btn = '0' then
                        estado <= IDLE;
                    end if;
            end case;
        end if;
    end process;

    enable <= estado_run;

end Behavioral;
